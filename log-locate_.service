# /etc/systemd/system/log-locate@.service
#
# Template service — one instance per watched log file.
# The instance name is the log file path with / replaced by -
#
# Enable for a file:
#   systemctl enable --now log-locate@home-deved-vpn-server-logs-server.log
#
# loglo add /path/to/app.log  handles this automatically.

[Unit]
Description=log-locate watcher/alerter for %I
After=network.target
PartOf=system.slice

[Service]
Type=simple
User=root

# %I is the instance name (URL-decoded systemd escaping)
ExecStart=/usr/local/bin/log-locate-daemon %I

Restart=on-failure
RestartSec=5s

EnvironmentFile=-/etc/log-locate/config

# Output goes to journald — view with:
#   journalctl -u log-locate@home-deved-vpn-server-logs-server.log -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=log-locate

[Install]
WantedBy=multi-user.target
