# /etc/systemd/system/log-locate@.service
#
# Template service — one instance per watched log file.
# loglo add /path/to/app.log  handles enable/start automatically.

[Unit]
Description=log-locate watcher/alerter for %I
After=network.target
PartOf=system.slice

[Service]
Type=simple
User=log-locate
Group=log-locate

ExecStart=/usr/local/bin/log-locate-daemon %I

Restart=on-failure
RestartSec=5s

# Resource limits
MemoryMax=64M
CPUQuota=10%

# Runtime directory for cooldown state persistence
RuntimeDirectory=log-locate
RuntimeDirectoryMode=0750

EnvironmentFile=-/etc/log-locate/config

# Output goes to journald — view with:
#   loglo logs /path/to/file.log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=log-locate

[Install]
WantedBy=multi-user.target
