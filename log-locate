#!/usr/bin/env bash
# /usr/local/bin/log-locate
# Symlinked as /usr/local/bin/loglo for convenience.

set -euo pipefail

GLOBAL_CONFIG="/etc/log-locate/config"
CONFIG_DIR="/etc/log-locate"
REGISTRY="/etc/log-locate/registry"   # name → abs_path, one per line
SERVICE_DIR="/etc/systemd/system"

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLU='\033[0;34m'
RST='\033[0m'

# ─── Helpers ──────────────────────────────────────────────────────────────────

_require_root() {
  if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}[loglo] This command requires root. Run with sudo.${RST}" >&2
    exit 1
  fi
}

# Convert abs path to a safe service name using only the --name or basename
# Service file: /etc/systemd/system/loglo-<name>.service
_service_name() {
  local name="$1"
  echo "loglo-${name}.service"
}

# Registry helpers — stores "name<TAB>abs_path" in /etc/log-locate/registry
_registry_add() {
  local name="$1" path="$2"
  mkdir -p "$CONFIG_DIR"
  # Remove old entry for same name or same path, then add new
  touch "$REGISTRY"
  grep -v -e "^${name}"$'\t' -e $'\t'"${path}$" "$REGISTRY" > "${REGISTRY}.tmp" || true
  echo -e "${name}\t${path}" >> "${REGISTRY}.tmp"
  mv "${REGISTRY}.tmp" "$REGISTRY"
}

_registry_remove() {
  local name="$1"
  touch "$REGISTRY"
  grep -v "^${name}"$'\t' "$REGISTRY" > "${REGISTRY}.tmp" || true
  mv "${REGISTRY}.tmp" "$REGISTRY"
}

_registry_path_to_name() {
  local path="$1"
  touch "$REGISTRY"
  awk -F'\t' -v p="$path" '$2==p {print $1; exit}' "$REGISTRY"
}

_registry_name_to_path() {
  local name="$1"
  touch "$REGISTRY"
  awk -F'\t' -v n="$name" '$1==n {print $2; exit}' "$REGISTRY"
}

# Resolve <file-or-name> → absolute path
# Accepts: a name from registry, a relative path, or an absolute path
_resolve() {
  local input="$1"
  # Try registry name first
  local from_registry
  from_registry=$(_registry_name_to_path "$input" || true)
  if [[ -n "$from_registry" ]]; then
    echo "$from_registry"
    return
  fi
  # Fall back to path
  realpath -m "$input"
}

# ─── Command: add ─────────────────────────────────────────────────────────────
cmd_add() {
  _require_root
  local file=""
  local name=""
  local index_patterns=""
  local alert_patterns=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)     name="$2";           shift 2 ;;
      --index)    index_patterns="$2"; shift 2 ;;
      --alert)    alert_patterns="$2"; shift 2 ;;
      --patterns) index_patterns="$2"; shift 2 ;;
      *)          file="$1";           shift   ;;
    esac
  done

  if [[ -z "$file" ]]; then
    echo -e "${RED}Usage: sudo loglo add <file> [--name myapp] [--index \"ip=* build=*\"] [--alert \"DENIED ALLOWED\"]${RST}" >&2
    exit 1
  fi

  local abs_file
  # Resolve to absolute path.
  # sudo preserves the caller's CWD in $PWD, so realpath -m works correctly
  # as long as we pass the current PWD explicitly as the base for relative paths.
if [[ "$file" = /* ]]; then
    abs_file="$file"
else
    abs_file=$(realpath -m "${PWD}/${file}")
fi
  # Default name is basename without extension e.g. server.log → server
  if [[ -z "$name" ]]; then
    name=$(basename "$abs_file" | sed 's/\.[^.]*$//')
    # If name already taken in registry for a different path, append suffix
    local existing
    existing=$(_registry_name_to_path "$name" || true)
    if [[ -n "$existing" && "$existing" != "$abs_file" ]]; then
      name="${name}_$(date +%s)"
    fi
  fi

  # Write per-file config if custom patterns were given
   if [[ -n "$index_patterns" || -n "$alert_patterns" ]]; then
    local conf_file="${CONFIG_DIR}/${name}.conf"
    mkdir -p "$CONFIG_DIR"
    {
      echo "# Per-file config for $abs_file (name: $name)"
      [[ -n "$index_patterns" ]] && echo "PATTERNS=\"$index_patterns\""
      [[ -n "$alert_patterns" ]] && echo "ALERT_PATTERNS=\"$alert_patterns\""
    } > "$conf_file"
    echo -e "${GRN}[loglo] Wrote config: $conf_file${RST}"
  fi

  # Register name → path
  _registry_add "$name" "$abs_file"

  # Write a dedicated service file — no escaping issues, real path embedded
  local service
  service=$(_service_name "$name")
  local unit_file="${SERVICE_DIR}/${service}"

  cat > "$unit_file" << UNIT
[Unit]
Description=loglo indexer/alerter — $name ($abs_file)
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/log-locate-daemon $abs_file $name
Restart=on-failure
RestartSec=5s
EnvironmentFile=-/etc/log-locate/config
EnvironmentFile=-/etc/log-locate/${name}.conf
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loglo-${name}

[Install]
WantedBy=multi-user.target
UNIT

  systemctl daemon-reload
  systemctl enable "$service" 2>/dev/null || true
  systemctl restart "$service"


  echo -e "${GRN}[loglo] Now watching : $abs_file${RST}"
  echo -e "${GRN}[loglo] Name        : $name${RST}"
  echo -e "${GRN}[loglo] Index file  : ${abs_file}.idx${RST}"
  echo -e "${BLU}[loglo] Service     : $service${RST}"
  echo ""
  echo "  View logs  : journalctl -u $service -f"
  echo "  Stop       : sudo loglo remove $name"
  echo "  Search     : loglo search $name \"ERROR\""
  echo "  Range      : loglo range $name 2026-05-28T10:15:00Z 2026-05-28T10:20:00Z"
}

# ─── Command: remove ──────────────────────────────────────────────────────────
cmd_remove() {
  _require_root
  local input="$1"
  if [[ -z "$input" ]]; then
    echo -e "${RED}Usage: sudo loglo remove <name-or-file>${RST}" >&2
    exit 1
  fi

  local abs_file
  if [[ "$input" = /* ]]; then
    abs_file="$input"
  else
    abs_file=$(realpath -m "${PWD}/${input}")
  fi
  local name
  name=$(_registry_path_to_name "$abs_file" || true)
  [[ -z "$name" ]] && name="$input"

  local service
  service=$(_service_name "$name")

  systemctl stop    "$service" 2>/dev/null || true
  systemctl disable "$service" 2>/dev/null || true
  rm -f "${SERVICE_DIR}/${service}"
  systemctl daemon-reload

  _registry_remove "$name"

  echo -e "${GRN}[loglo] Stopped watching: $abs_file (name: $name)${RST}"
}

# ─── Command: status ──────────────────────────────────────────────────────────
cmd_status() {
  echo -e "${BLU}loglo — watched files${RST}"
  echo '─────────────────────────────────────────────────────────────────'

  local found=false

  touch "$REGISTRY" 2>/dev/null || true

  while IFS=$'\t' read -r name abs_file; do
    [[ -z "$name" || -z "$abs_file" ]] && continue

    local service
    service=$(_service_name "$name")

    # is-active can print "activating" to stdout — capture it cleanly
    local state
    state=$(systemctl is-active "$service" 2>/dev/null || true)
    state=$(echo "$state" | tr -d '[:space:]')
    [[ -z "$state" ]] && state="inactive"

    local color=$RED
    [[ "$state" == "active" ]]     && color=$GRN
    [[ "$state" == "activating" ]] && color=$YLW

    printf "  ${color}%-12s${RST}  %-20s  %s\n" "$state" "$name" "$abs_file"

    if [[ -f "${abs_file}.idx" ]]; then
      local idx_lines
      idx_lines=$(wc -l < "${abs_file}.idx")
      printf "               Index : %s entries\n" "$idx_lines"
    else
      printf "               Index : not yet created\n"
    fi

    found=true
  done < "$REGISTRY"

  if ! $found; then
    echo "  No files being watched."
    echo "  Run: sudo loglo add <file>"
  fi
  echo '─────────────────────────────────────────────────────────────────'
}

# ─── Command: list ────────────────────────────────────────────────────────────
cmd_list() {
  touch "$REGISTRY" 2>/dev/null || true
  echo -e "${BLU}Registered names:${RST}"
  while IFS=$'\t' read -r name abs_file; do
    [[ -z "$name" ]] && continue
    echo "  $name  →  $abs_file"
  done < "$REGISTRY"
}

# ─── Command: help ────────────────────────────────────────────────────────────
cmd_help() {
  cat <<HELP

${BLU}loglo${RST} — log indexer and alerter

Usage:
  sudo loglo add          <file> [--name <name>] [--alert "ERROR FATAL"]
  sudo loglo remove       <name-or-file>
       loglo logs         <name-or-file>
       loglo test-alert
       loglo search       <name-or-file> <keyword>
       loglo range        <name-or-file> <from-ts> <to-ts>
       loglo status
       loglo list
       loglo help

Examples:
  # Add with auto name (uses filename without extension e.g. "server")
  sudo loglo add /home/deved/vpn-server/logs/server.log

  # Add with custom name
  sudo loglo add /home/deved/vpn-server/logs/server.log --name vpn

  # Search by name — no need to type the full path
  loglo search vpn "ERROR"
  loglo search vpn "user_id=99999"

  # Range search by name
  loglo range vpn 2026-05-28T10:15:00Z 2026-05-28T10:20:00Z

  # Remove by name
  sudo loglo remove vpn

  # Status and list
  loglo status
  loglo list

HELP
}

# ─── Command: logs ────────────────────────────────────────────────────────────
cmd_logs() {
  local input="${1:-}"
  if [[ -z "$input" ]]; then
    echo -e "${RED}Usage: loglo logs <name-or-file>${RST}" >&2
    exit 1
  fi
  local abs_file
  abs_file=$(_resolve "$input")
  local name
  name=$(_registry_path_to_name "$abs_file" || true)
  [[ -z "$name" ]] && name="$input"
  local service
  service=$(_service_name "$name")
  exec journalctl -u "$service" -f
}

# ─── Command: test-alert ──────────────────────────────────────────────────────
cmd_test_alert() {
  [[ -f "$GLOBAL_CONFIG" ]] && source "$GLOBAL_CONFIG"

  local hostname_val
  hostname_val=$(hostname)
  local timestamp
  timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  local msg="🔔 [log-locate] Test alert from ${hostname_val} at ${timestamp}. If you received this, notifications are working correctly."

  NOTIFY="${NOTIFY:-telegram}"
  local sent=0

  if [[ "$NOTIFY" == "telegram" || "$NOTIFY" == "both" ]]; then
    if [[ -z "${TELEGRAM_BOT_TOKEN:-}" || -z "${TELEGRAM_CHAT_ID:-}" ]]; then
      echo -e "${RED}Telegram not configured (TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID missing in config)${RST}" >&2
    else
      local resp
      resp=$(curl -sf -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d chat_id="${TELEGRAM_CHAT_ID}" \
        -d text="${msg}" || echo "FAILED")
      if echo "$resp" | grep -q '"ok":true'; then
        echo -e "${GRN}Telegram: test message sent successfully.${RST}"
        sent=1
      else
        echo -e "${RED}Telegram: failed to send. Response: $resp${RST}" >&2
      fi
    fi
  fi

  if [[ "$NOTIFY" == "email" || "$NOTIFY" == "both" ]]; then
    if [[ -z "${SMTP_USER:-}" || -z "${SMTP_PASS:-}" || -z "${ALERT_TO:-}" ]]; then
      echo -e "${RED}Email not configured (SMTP_USER / SMTP_PASS / ALERT_TO missing in config)${RST}" >&2
    else
      local from="${ALERT_FROM:-$SMTP_USER}"
      curl -sf \
        --url "smtp://${SMTP_HOST}:${SMTP_PORT}" \
        --ssl-reqd \
        --mail-from "$from" \
        --mail-rcpt "${ALERT_TO}" \
        --user "${SMTP_USER}:${SMTP_PASS}" \
        -T <(printf "From: %s\nTo: %s\nSubject: [log-locate] Test Alert\n\n%s\n" \
              "$from" "${ALERT_TO}" "$msg") \
        && echo -e "${GRN}Email: test message sent successfully.${RST}" && sent=1 \
        || echo -e "${RED}Email: failed to send.${RST}" >&2
    fi
  fi

  [[ $sent -eq 0 ]] && echo -e "${YLW}No notifications sent. Check your config: $GLOBAL_CONFIG${RST}"
}

# ─── Router ───────────────────────────────────────────────────────────────────
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  add)          cmd_add        "$@" ;;
  remove)       cmd_remove     "$@" ;;
  status)       cmd_status          ;;
  list)         cmd_list            ;;
  logs)         cmd_logs       "$@" ;;
  test-alert)   cmd_test_alert      ;;
  help|--help|-h) cmd_help          ;;
  *)
    echo -e "${RED}[loglo] Unknown command: $COMMAND${RST}" >&2
    cmd_help
    exit 1
    ;;
esac
