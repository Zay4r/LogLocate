#!/usr/bin/env bash
# /usr/local/bin/loglo

set -euo pipefail

GLOBAL_CONFIG="/etc/log-locate/config"
CONFIG_DIR="/etc/log-locate"
SERVICE_TEMPLATE="log-locate@"
SERVICE_DIR="/etc/systemd/system"

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLU='\033[0;34m'
RST='\033[0m'

# ─── Helpers ──────────────────────────────────────────────────────────────────

# Use systemd-escape for safe path → instance name conversion.
# This correctly handles hyphens, spaces, and special chars in paths.
# /home/deved/vpn-server/logs/server.log → home-deved-vpn\x2dserver-logs-server.log
_path_to_instance() {
  systemd-escape --path "$1"
}

# Decode instance name back to real path
_instance_to_path() {
  systemd-escape --path --unescape "$1"
}

_require_root() {
  if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}[loglo] This command requires root. Run with sudo.${RST}" >&2
    exit 1
  fi
}

# ─── Command: add ─────────────────────────────────────────────────────────────
cmd_add() {
  _require_root
  local file=""
  local patterns=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --patterns) patterns="$2"; shift 2 ;;
      *)          file="$1";     shift   ;;
    esac
  done

  if [[ -z "$file" ]]; then
    echo -e "${RED}Usage: loglo add <file> [--patterns \"ERROR user_id=*\"]${RST}" >&2
    exit 1
  fi

  local abs_file
  abs_file=$(realpath -m "$file")

  # Write per-file config if custom patterns were given
  if [[ -n "$patterns" ]]; then
    local conf_file="${CONFIG_DIR}/$(basename "$abs_file").conf"
    mkdir -p "$CONFIG_DIR"
    cat > "$conf_file" <<CONF
# Per-file config for $abs_file
PATTERNS="$patterns"
ALERT_PATTERNS="$patterns"
CONF
    echo -e "${GRN}[loglo] Wrote config: $conf_file${RST}"
  fi

  local instance
  instance=$(_path_to_instance "$abs_file")
  local service="${SERVICE_TEMPLATE}${instance}.service"
  local unit_file="${SERVICE_DIR}/${service}"

  # Write a per-instance service file that passes the real path explicitly.
  # This avoids relying on instance name decoding entirely.
  cat > "$unit_file" <<UNIT
[Unit]
Description=loglo indexer/alerter for $abs_file
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/loglo-daemon $abs_file
Restart=on-failure
RestartSec=5s
EnvironmentFile=-/etc/log-locate/config
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loglo

[Install]
WantedBy=multi-user.target
UNIT

  systemctl daemon-reload
  systemctl enable "$service" 2>/dev/null || true
  systemctl restart "$service"

  echo -e "${GRN}[loglo] Now watching: $abs_file${RST}"
  echo -e "${GRN}[loglo] Index file  : ${abs_file}.idx${RST}"
  echo -e "${BLU}[loglo] Service     : $service${RST}"
  echo ""
  echo "  View logs : journalctl -u $service -f"
  echo "  Stop      : loglo remove $abs_file"
}

# ─── Command: remove ──────────────────────────────────────────────────────────
cmd_remove() {
  _require_root
  local file="$1"
  if [[ -z "$file" ]]; then
    echo -e "${RED}Usage: loglo remove <file>${RST}" >&2
    exit 1
  fi

  local abs_file
  abs_file=$(realpath -m "$file")
  local instance
  instance=$(_path_to_instance "$abs_file")
  local service="${SERVICE_TEMPLATE}${instance}.service"

  systemctl stop    "$service" 2>/dev/null || true
  systemctl disable "$service" 2>/dev/null || true
  rm -f "${SERVICE_DIR}/${service}"
  systemctl daemon-reload

  echo -e "${GRN}[loglo] Stopped watching: $abs_file${RST}"
}

# ─── Command: search ──────────────────────────────────────────────────────────
cmd_search() {
  local file="$1"
  local keyword="$2"

  if [[ -z "$file" || -z "$keyword" ]]; then
    echo -e "${RED}Usage: loglo search <file> <keyword>${RST}" >&2
    exit 1
  fi

  local abs_file
  abs_file=$(realpath -m "$file")
  local idx_file="${abs_file}.idx"

  if [[ ! -f "$idx_file" ]]; then
    echo -e "${RED}[loglo] Index not found: $idx_file${RST}" >&2
    echo "  Run: sudo loglo add $abs_file"
    exit 1
  fi

  local start_ns
  start_ns=$(date +%s%N)
  local count=0

  while IFS=$'\t' read -r token line_num timestamp; do
    local match=false
    if [[ "$keyword" == *"*" ]]; then
      local prefix="${keyword%\*}"
      [[ "$token" == "$prefix"* ]] && match=true
    else
      [[ "$token" == "$keyword" ]] && match=true
    fi

    if $match; then
      printf "${YLW}line %-8s${RST} ${BLU}%s${RST}  %s\n" \
        "$line_num" "$timestamp" "$token"
      count=$(( count + 1 ))
    fi
  done < "$idx_file"

  local elapsed_ms=$(( ($(date +%s%N) - start_ns) / 1000000 ))
  echo ""
  echo -e "${GRN}$count result(s) for \"$keyword\" — ${elapsed_ms}ms${RST}"
}

# ─── Command: range ───────────────────────────────────────────────────────────
cmd_range() {
  local file="$1"
  local from_ts="$2"
  local to_ts="$3"

  if [[ -z "$file" || -z "$from_ts" || -z "$to_ts" ]]; then
    echo -e "${RED}Usage: loglo range <file> <from-ts> <to-ts>${RST}" >&2
    echo "  Example: loglo range /path/to/app.log 2026-05-28T10:15:00Z 2026-05-28T10:20:00Z"
    exit 1
  fi

  local abs_file
  abs_file=$(realpath -m "$file")
  local idx_file="${abs_file}.idx"

  if [[ ! -f "$idx_file" ]]; then
    echo -e "${RED}[loglo] Index not found: $idx_file${RST}" >&2
    exit 1
  fi

  local start_ns
  start_ns=$(date +%s%N)

  # Binary search to find byte offset where timestamps >= from_ts begin
  local file_size lo=0 hi mid ts
  file_size=$(wc -c < "$idx_file")
  hi=$file_size

  while (( lo < hi )); do
    mid=$(( (lo + hi) / 2 ))
    ts=$(dd if="$idx_file" bs=1 skip="$mid" count=512 2>/dev/null \
      | awk -F'\t' 'NR==2 && NF>=3 {print $3; exit}')

    if [[ -z "$ts" || "$ts" < "$from_ts" ]]; then
      lo=$(( mid + 1 ))
    else
      hi=$mid
    fi
  done

  local count=0
  dd if="$idx_file" bs=1 skip="$lo" 2>/dev/null \
    | awk -F'\t' -v from="$from_ts" -v to="$to_ts" \
        -v YLW='\033[1;33m' -v BLU='\033[0;34m' -v RST='\033[0m' '
        NR==1 { next }
        NF < 3 { next }
        $3 > to  { exit }
        $3 >= from {
          printf YLW "line %-8s" RST " " BLU "%s" RST "  %s\n", $2, $3, $1
          count++
        }
        END { printf "\n%d result(s)\n", count > "/dev/stderr" }
      '

  local elapsed_ms=$(( ($(date +%s%N) - start_ns) / 1000000 ))
  echo -e "${GRN}Range search done — ${elapsed_ms}ms${RST}"
}

# ─── Command: status ──────────────────────────────────────────────────────────
cmd_status() {
  echo -e "${BLU}loglo — watched files${RST}"
  echo '─────────────────────────────────────────────────────────────────'

  local found=false

  # Scan unit files on disk — more reliable than list-units
  # which only shows loaded/active units
  for unit_file in "${SERVICE_DIR}"/log-locate@*.service; do
    [[ -f "$unit_file" ]] || continue

    # Extract real log file path from ExecStart line
    local file_path
    file_path=$(grep -oP '(?<=ExecStart=/usr/local/bin/loglo-daemon ).*' "$unit_file" || true)
    [[ -z "$file_path" ]] && continue

    local unit
    unit=$(basename "$unit_file")
    local state
    state=$(systemctl is-active "$unit" 2>/dev/null || echo "inactive")

    local color=$RED
    [[ "$state" == "active" ]] && color=$GRN

    printf "  ${color}%-10s${RST}  %s\n" "$state" "$file_path"

    if [[ -f "${file_path}.idx" ]]; then
      local idx_lines
      idx_lines=$(wc -l < "${file_path}.idx")
      printf "             Index: %s entries\n" "$idx_lines"
    else
      printf "             Index: not yet created\n"
    fi

    found=true
  done

  if ! $found; then
    echo "  No files being watched."
    echo "  Run: sudo loglo add <file>"
  fi
  echo '─────────────────────────────────────────────────────────────────'
}

# ─── Command: help ────────────────────────────────────────────────────────────
cmd_help() {
  cat <<HELP

${BLU}log-locate${RST} — log indexer and alerter

Usage:
  sudo loglo add    <file> [--patterns "ERROR user_id=* request_id=*"]
  sudo loglo remove <file>
       loglo search <file> <keyword>
       loglo range  <file> <from-ts> <to-ts>
       loglo status
       loglo help

Examples:
  sudo loglo add /home/deved/vpn-server/logs/server.log
  sudo loglo add /home/deved/vpn-server/logs/server.log --patterns "ERROR WARN user_id=*"

  loglo search /home/deved/vpn-server/logs/server.log "ERROR"
  loglo search /home/deved/vpn-server/logs/server.log "user_id=99999"

  loglo range /home/deved/vpn-server/logs/server.log 2026-05-28T10:15:00Z 2026-05-28T10:20:00Z

  loglo status

HELP
}

# ─── Router ───────────────────────────────────────────────────────────────────
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  add)    cmd_add    "$@" ;;
  remove) cmd_remove "$@" ;;
  search) cmd_search "$@" ;;
  range)  cmd_range  "$@" ;;
  status) cmd_status      ;;
  help|--help|-h) cmd_help ;;
  *)
    echo -e "${RED}[loglo] Unknown command: $COMMAND${RST}" >&2
    cmd_help
    exit 1
    ;;
esac
