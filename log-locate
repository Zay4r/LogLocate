#!/usr/bin/env bash
# /usr/local/bin/log-locate
#
# CLI tool for log-locate.
#
# Commands:
#   log-locate add    <file> [--patterns "ERROR user_id=*"]
#   log-locate remove <file>
#   log-locate search <file> <keyword>
#   log-locate range  <file> <from-ts> <to-ts>
#   log-locate status
#   log-locate help

set -euo pipefail

GLOBAL_CONFIG="/etc/log-locate/config"
CONFIG_DIR="/etc/log-locate"
SERVICE_TEMPLATE="log-locate@"

# ─── Colours ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLU='\033[0;34m'
RST='\033[0m'

# ─── Helpers ──────────────────────────────────────────────────────────────────

# Convert a file path to a systemd instance name
# /etc/project/logs/app.log → etc-project-logs-app.log
_path_to_instance() {
  echo "$1" | sed 's|^/||; s|/|-|g'
}

# Convert a systemd instance name back to a file path
_instance_to_path() {
  echo "/$( echo "$1" | sed 's|-|/|g' )"
}

_require_root() {
  if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}[log-locate] This command requires root. Run with sudo.${RST}" >&2
    exit 1
  fi
}

_load_config() {
  PATTERNS="ERROR WARN FATAL"
  ALERT_PATTERNS="ERROR FATAL 500"
  [[ -f "$GLOBAL_CONFIG" ]] && source "$GLOBAL_CONFIG"
}

# ─── Command: add ─────────────────────────────────────────────────────────────
cmd_add() {
  _require_root
  local file=""
  local patterns=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --patterns) patterns="$2"; shift 2 ;;
      *)          file="$1";     shift   ;;
    esac
  done

  if [[ -z "$file" ]]; then
    echo -e "${RED}Usage: log-locate add <file> [--patterns \"ERROR user_id=*\"]${RST}" >&2
    exit 1
  fi

  local abs_file
  abs_file=$(realpath -m "$file")

  # Write per-file config if custom patterns were given
  if [[ -n "$patterns" ]]; then
    local conf_file="${CONFIG_DIR}/$(basename "$abs_file").conf"
    mkdir -p "$CONFIG_DIR"
    cat > "$conf_file" <<EOF
# Per-file config for $abs_file
PATTERNS="$patterns"
ALERT_PATTERNS="$patterns"
EOF
    echo -e "${GRN}[log-locate] Wrote config: $conf_file${RST}"
  fi

  # Enable and start the systemd service instance
  local instance
  instance=$(_path_to_instance "$abs_file")
  local service="${SERVICE_TEMPLATE}${instance}.service"

  systemctl enable "$service" 2>/dev/null || true
  systemctl restart "$service"

  echo -e "${GRN}[log-locate] Now watching: $abs_file${RST}"
  echo -e "${GRN}[log-locate] Index file  : ${abs_file}.idx${RST}"
  echo -e "${BLU}[log-locate] Service     : $service${RST}"
  echo ""
  echo "  View logs : journalctl -u $service -f"
  echo "  Stop      : log-locate remove $abs_file"
}

# ─── Command: remove ──────────────────────────────────────────────────────────
cmd_remove() {
  _require_root
  local file="$1"
  if [[ -z "$file" ]]; then
    echo -e "${RED}Usage: log-locate remove <file>${RST}" >&2
    exit 1
  fi

  local abs_file
  abs_file=$(realpath -m "$file")
  local instance
  instance=$(_path_to_instance "$abs_file")
  local service="${SERVICE_TEMPLATE}${instance}.service"

  systemctl stop    "$service" 2>/dev/null || true
  systemctl disable "$service" 2>/dev/null || true

  echo -e "${GRN}[log-locate] Stopped watching: $abs_file${RST}"
}

# ─── Command: search ──────────────────────────────────────────────────────────
cmd_search() {
  local file="$1"
  local keyword="$2"

  if [[ -z "$file" || -z "$keyword" ]]; then
    echo -e "${RED}Usage: log-locate search <file> <keyword>${RST}" >&2
    exit 1
  fi

  local abs_file
  abs_file=$(realpath -m "$file")
  local idx_file="${abs_file}.idx"

  if [[ ! -f "$idx_file" ]]; then
    echo -e "${RED}[log-locate] Index not found: $idx_file${RST}" >&2
    echo "  Run: log-locate add $abs_file"
    exit 1
  fi

  local start_ns
  start_ns=$(date +%s%N)

  local count=0
  while IFS=$'\t' read -r token line_num timestamp; do
    # Support prefix wildcard in search too: user_id=*
    local match=false
    if [[ "$keyword" == *"*" ]]; then
      local prefix="${keyword%\*}"
      [[ "$token" == "$prefix"* ]] && match=true
    else
      [[ "$token" == "$keyword" ]] && match=true
    fi

    if $match; then
      printf "${YLW}line %-8s${RST} ${BLU}%s${RST}  %s\n" \
        "$line_num" "$timestamp" "$token"
      count=$(( count + 1 ))
    fi
  done < "$idx_file"

  local end_ns
  end_ns=$(date +%s%N)
  local elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))

  echo ""
  echo -e "${GRN}$count result(s) for \"$keyword\" — ${elapsed_ms}ms${RST}"
}

# ─── Command: range ───────────────────────────────────────────────────────────
# Binary search on the index file to find the start offset of fromTs,
# then stream from there until toTs is exceeded.
cmd_range() {
  local file="$1"
  local from_ts="$2"
  local to_ts="$3"

  if [[ -z "$file" || -z "$from_ts" || -z "$to_ts" ]]; then
    echo -e "${RED}Usage: log-locate range <file> <from-ts> <to-ts>${RST}" >&2
    echo "  Example: log-locate range /etc/project/logs/app.log 2026-05-28T10:15:00Z 2026-05-28T10:20:00Z"
    exit 1
  fi

  local abs_file
  abs_file=$(realpath -m "$file")
  local idx_file="${abs_file}.idx"

  if [[ ! -f "$idx_file" ]]; then
    echo -e "${RED}[log-locate] Index not found: $idx_file${RST}" >&2
    exit 1
  fi

  local start_ns
  start_ns=$(date +%s%N)

  # Binary search to find byte offset where timestamps >= from_ts begin
  local file_size
  file_size=$(wc -c < "$idx_file")
  local lo=0
  local hi=$file_size
  local mid ts

  while (( lo < hi )); do
    mid=$(( (lo + hi) / 2 ))
    # Read 512 bytes at mid, skip first (partial) line, read next complete line
    ts=$(dd if="$idx_file" bs=1 skip="$mid" count=512 2>/dev/null \
      | awk -F'\t' 'NR==2 && NF>=3 {print $3; exit}')

    if [[ -z "$ts" || "$ts" < "$from_ts" ]]; then
      lo=$(( mid + 1 ))
    else
      hi=$mid
    fi
  done

  # Stream from the found offset, skip one partial line, then filter range
  local count=0
  dd if="$idx_file" bs=1 skip="$lo" 2>/dev/null \
    | awk -F'\t' -v from="$from_ts" -v to="$to_ts" '
        NR==1 { next }          # skip possible partial first line
        NF < 3 { next }
        $3 > to { exit }
        $3 >= from {
          printf "line %-8s %s  %s\n", $2, $3, $1
          count++
        }
        END { print count " result(s)" > "/dev/stderr" }
      '

  local end_ns
  end_ns=$(date +%s%N)
  local elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))

  echo ""
  echo -e "${GRN}Range search done — ${elapsed_ms}ms${RST}"
}

# ─── Command: status ──────────────────────────────────────────────────────────
cmd_status() {
  echo -e "${BLU}log-locate — watched files${RST}"
  echo '─────────────────────────────────────────────────────────────────'

  local found=false
  while IFS= read -r unit; do
    local instance
    instance=$(echo "$unit" | sed "s|${SERVICE_TEMPLATE}||; s|\.service||")
    local file_path
    file_path=$(_instance_to_path "$instance")
    local state
    state=$(systemctl is-active "${unit}" 2>/dev/null || echo "inactive")

    local color=$RED
    [[ "$state" == "active" ]] && color=$GRN

    printf "  ${color}%-10s${RST}  %s\n" "$state" "$file_path"

    if [[ -f "${file_path}.idx" ]]; then
      local idx_lines
      idx_lines=$(wc -l < "${file_path}.idx")
      printf "             Index: %s entries\n" "$idx_lines"
    fi

    found=true
  done < <(systemctl list-units --type=service --all \
    | grep "${SERVICE_TEMPLATE}" \
    | awk '{print $1}')

  if ! $found; then
    echo "  No files being watched."
    echo "  Run: log-locate add <file>"
  fi
  echo '─────────────────────────────────────────────────────────────────'
}

# ─── Command: help ────────────────────────────────────────────────────────────
cmd_help() {
  cat <<EOF

${BLU}log-locate${RST} — log indexer and alerter

Usage:
  log-locate add    <file> [--patterns "ERROR user_id=* request_id=*"]
  log-locate remove <file>
  log-locate search <file> <keyword>
  log-locate range  <file> <from-ts> <to-ts>
  log-locate status
  log-locate help

Examples:
  # Start watching a log file with default patterns (ERROR WARN FATAL)
  sudo log-locate add /etc/project/logs/app.log

  # Watch with custom patterns
  sudo log-locate add /etc/project/logs/app.log --patterns "ERROR WARN user_id=* request_id=*"

  # Search the index instantly
  log-locate search /etc/project/logs/app.log "user_id=87904"
  log-locate search /etc/project/logs/app.log "ERROR"

  # Find all entries in a time window
  log-locate range /etc/project/logs/app.log 2026-05-28T10:15:00Z 2026-05-28T10:20:00Z

  # See all watched files and their status
  log-locate status

Config files:
  /etc/log-locate/config            Global defaults
  /etc/log-locate/<filename>.conf   Per-file overrides

Index files:
  Stored next to the log file as <logfile>.idx

EOF
}

# ─── Router ───────────────────────────────────────────────────────────────────
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  add)    cmd_add    "$@" ;;
  remove) cmd_remove "$@" ;;
  search) cmd_search "$@" ;;
  range)  cmd_range  "$@" ;;
  status) cmd_status      ;;
  help|--help|-h) cmd_help ;;
  *)
    echo -e "${RED}[log-locate] Unknown command: $COMMAND${RST}" >&2
    cmd_help
    exit 1
    ;;
esac
